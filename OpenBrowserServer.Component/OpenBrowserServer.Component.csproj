<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows 版は MessageBox や SoundPlayer を使うため -windows とする。
         UBUNTU(ヘッドレス)ビルドはこのプロジェクトを参照せず、ソースを直接コンパイルする -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Configurations>Debug;Release;Booth;Free</Configurations>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>OpenBrowserServer.Component</RootNamespace>
    <AssemblyName>OpenBrowserServer.Component</AssemblyName>
    <!-- バージョン情報は Properties\AssemblyInfo.cs を正とする -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- System.Drawing.Image のため。実行できるのは Windows のみで、UBUNTU ビルドでは使われない -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- System.Media.SoundPlayer のため -->
    <PackageReference Include="System.Windows.Extensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBrowserServer.Logger\OpenBrowserServer.Logger.csproj" />
  </ItemGroup>

</Project>
