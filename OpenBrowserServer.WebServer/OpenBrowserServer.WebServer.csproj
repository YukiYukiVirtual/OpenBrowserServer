<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Component(net10.0-windows)を参照するため -windows に合わせる -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>OpenBrowserServer.WebServer</RootNamespace>
    <AssemblyName>OpenBrowserServer.WebServer</AssemblyName>
    <!-- バージョン情報は Properties\AssemblyInfo.cs を正とする -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBrowserServer.Component\OpenBrowserServer.Component.csproj" />
    <ProjectReference Include="..\OpenBrowserServer.Logger\OpenBrowserServer.Logger.csproj" />
  </ItemGroup>

</Project>
