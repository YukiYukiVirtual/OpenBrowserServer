<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ubuntu(ヘッドレス)ビルド用プロジェクト。
    Windows版の Component / WebServer / Logger のソースをそのままリンクし、
    UBUNTU シンボルでプラットフォーム依存箇所を差し替えてビルドする。
    WinForms の画面(トレイ/コントロールパネル)は含まない。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);UBUNTU</DefineConstants>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>OpenBrowserServer.Headless</AssemblyName>
    <RootNamespace>OpenBrowserServer.Headless</RootNamespace>
    <!-- バージョンは VersionMaster.txt の手順に合わせて手でそろえる -->
    <Version>6.1.1</Version>
    <FileVersion>6.1.1.0</FileVersion>
    <AssemblyVersion>6.1.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenBrowserServer.Component -->
    <Compile Include="..\OpenBrowserServer.Component\Config.cs" Link="Component\Config.cs" />
    <Compile Include="..\OpenBrowserServer.Component\DialogWrapper.cs" Link="Component\DialogWrapper.cs" />
    <Compile Include="..\OpenBrowserServer.Component\JsonDownloader.cs" Link="Component\JsonDownloader.cs" />
    <Compile Include="..\OpenBrowserServer.Component\OpenBrowserToken.cs" Link="Component\OpenBrowserToken.cs" />
    <Compile Include="..\OpenBrowserServer.Component\Setting.cs" Link="Component\Setting.cs" />
    <Compile Include="..\OpenBrowserServer.Component\URLOpener.cs" Link="Component\URLOpener.cs" />
    <Compile Include="..\OpenBrowserServer.Component\VRChatLogWatcher.cs" Link="Component\VRChatLogWatcher.cs" />
    <!-- OpenBrowserServer.WebServer -->
    <Compile Include="..\OpenBrowserServer.WebServer\HttpServer.cs" Link="WebServer\HttpServer.cs" />
    <Compile Include="..\OpenBrowserServer.WebServer\HttpServer.Response.cs" Link="WebServer\HttpServer.Response.cs" />
    <Compile Include="..\OpenBrowserServer.WebServer\MimeMapping.cs" Link="WebServer\MimeMapping.cs" />
    <!-- OpenBrowserServer.Logger -->
    <Compile Include="..\OpenBrowserServer.Logger\History.cs" Link="Logger\History.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- JsonDownloader の Image 型のためだけに参照する(UBUNTUビルドでは画像取得自体を行わない) -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
