<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Configurations>Debug;Release;Booth;Free</Configurations>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OpenBrowserServer</RootNamespace>
    <AssemblyName>VRChatOpenBrowser</AssemblyName>
    <!-- バージョン情報は Properties\AssemblyInfo.cs を正とする -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>ice.ico</ApplicationIcon>
    <StartupObject>OpenBrowserServer.Program</StartupObject>
    <!-- Windows 以外の環境でもビルド確認できるようにする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- .resx 内のバイナリリソースを Windows 以外でも処理できるようにする -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- .NET 10 ランタイムは Windows に標準搭載されていないため、自己完結(ランタイム同梱)で配布する -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- 旧来の構成名(Booth/Free)を維持する。Free 以外は BOOTH 版としてビルドする -->
  <PropertyGroup Condition="'$(Configuration)' != 'Free'">
    <DefineConstants>$(DefineConstants);BOOTH</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Properties\Settings.Designer.cs (ApplicationSettingsBase) のため -->
    <!-- GenerateResourceUsePreserializedResources の実行時サポート -->
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBrowserServer.Component\OpenBrowserServer.Component.csproj" />
    <ProjectReference Include="..\OpenBrowserServer.Logger\OpenBrowserServer.Logger.csproj" />
    <ProjectReference Include="..\OpenBrowserServer.WebServer\OpenBrowserServer.WebServer.csproj" />
  </ItemGroup>

</Project>
